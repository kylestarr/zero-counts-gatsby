      "Bash(node -e \"require\\('puppeteer-core'\\); console.log\\('ok'\\)\")",
      "Bash(ls node_modules | grep marked; node -e \"require\\('marked'\\); console.log\\('ok'\\)\" 2>&1)",
      "Bash(npm install marked@4 --no-save 2>&1 | grep -E \"\\(added|error|warn\\)\" | head -10)",
      "Bash(node -e \"require\\('marked'\\); require\\('puppeteer-core'\\); require\\('gray-matter'\\); console.log\\('all ok'\\)\")",
